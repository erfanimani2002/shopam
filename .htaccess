# Shopam root .htaccess
# Routing: /api/* -> api/index.php (JSON API); everything else -> /public/
<IfModule mod_rewrite.c>
    RewriteEngine On

    # API front controller (stop here, do not rewrite again)
    RewriteRule ^api/index\.php$ - [L]
    RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

    # Already inside public/ -> stop (prevents the rewrite loop)
    RewriteRule ^public/ - [L]

    # Everything else is served from /public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>